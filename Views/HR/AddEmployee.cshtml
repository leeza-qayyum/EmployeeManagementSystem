@model EmployeeManagementSystem.Models.Employee
@{
    ViewData["Title"] = "Add Employee";
}

<h2 class="text-white">Add Employee</h2>

<form method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label>Profile Picture</label>
        <input type="file" name="profileImage" class="form-control" accept="image/*" />
    </div>
    <div class="mb-3">
    <label>Name</label>
    <input asp-for="Name" class="form-control" required />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label>Email (must end with @@gmail.com)</label>
    <input asp-for="Email" class="form-control" type="email" required />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>

<div class="mb-3">
    <label>Department</label>
    <input asp-for="Department" class="form-control" required />
    <span asp-validation-for="Department" class="text-danger"></span>
</div>

<div class="mb-3">
    <label>Phone (11 digits, no spaces or dashes)</label>
    <input asp-for="Phone" class="form-control" 
           pattern="\d{11}" 
           title="Enter exactly 11 numeric digits" required />
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>

<div class="mb-3">
    <label>Salary</label>
    <input asp-for="Salary" class="form-control" type="number" step="0.01" required />
    <span asp-validation-for="Salary" class="text-danger"></span>
</div>
    <button type="submit" class="btn btn-success">Add</button>
    <a asp-action="ManageEmployees" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}