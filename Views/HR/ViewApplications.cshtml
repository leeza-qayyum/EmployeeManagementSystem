@using EmployeeManagementSystem.Models
@model List<EmployeeManagementSystem.Models.JobApplication>
@{
    var job = ViewBag.Job as JobPosting;
    ViewData["Title"] = $"Applications for {job?.Title}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <form method="post" asp-action="RejectAllNonShortlisted" asp-route-jobId="@job?.Id"
          onsubmit="return confirm('Send rejection emails to ALL candidates who were not shortlisted? This action cannot be undone.')"
          style="display: inline;">
        <button type="submit" class="btn btn-sm btn-danger me-2">
            <i class="bi bi-envelope-paper"></i> Reject All Others
        </button>
    </form>
    <h2>Applications for @job?.Title</h2>
    <a asp-action="ManageJobPostings" class="btn btn-secondary">Back to Jobs</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No applications received yet.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Candidate</th>
                        <th>Contact</th>
                        <th>Match Score</th>
                        <th>Applied Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model)
                    {
                        <tr>
                            <td>
                                <strong>@app.CandidateName</strong>
                            </td>
                            <td>
                                @app.Email<br />
                                <small>@app.Phone</small>
                            </td>
                            <td>
                                <span class="badge-active">@app.MatchScore%</span>
                            </td>
                            <td>@app.AppliedDate.ToShortDateString()</td>
                            <td>
                                @if (app.Status == "Shortlisted")
                                {
                                    <span class="badge-active">Shortlisted</span>
                                }
                                else if (app.Status == "Hired")
                                {
                                    <span class="badge" style="background-color: #2E7D32; color: white;">Hired</span>
                                }
                                else
                                {
                                    <span class="badge-secondary">@app.Status</span>
                                }
                            </td>
                            <td>
                                @if (app.Status != "Hired" && app.Status != "Shortlisted")
                                {
                                    <a asp-action="ShortlistCandidate" asp-route-id="@app.Id" class="btn btn-sm btn-teal">Shortlist</a>
                                }
                                else if (app.Status == "Rejected")
                                {
                                    <span class="badge-terminated">Rejected</span>
                                }
                                @if (app.CVFilePath != null)
                                {
                                    <a href="@app.CVFilePath" target="_blank" class="btn btn-sm btn-secondary">View CV</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="ShortlistedCandidates" asp-route-jobId="@job?.Id" class="btn btn-primary">View Shortlisted</a>
</div>