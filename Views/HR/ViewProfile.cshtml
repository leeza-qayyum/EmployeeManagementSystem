@model EmployeeManagementSystem.Models.Employee
@{
    ViewData["Title"] = "My Profile";
}
<h2>HR Manager Profile</h2>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.Email</dd>

                    <dt class="col-sm-3">Department</dt>
                    <dd class="col-sm-9">@Model.Department</dd>

                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@Model.Phone</dd>

                    <dt class="col-sm-3">Salary</dt>
                    <dd class="col-sm-9">@Model.Salary</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-4 text-center">
        @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
        {
            <img src="@Model.ProfilePicturePath" class="profile-picture" />
        }
        else
        {
            <i class="bi bi-person-circle" style="font-size: 150px;"></i>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="EditProfile" class="btn btn-primary">Edit Profile</a>
    <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>