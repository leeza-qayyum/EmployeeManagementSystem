@using EmployeeManagementSystem.Models
@model List<EmployeeManagementSystem.Models.JobApplication>
@{
    var job = ViewBag.Job as JobPosting;
    ViewData["Title"] = $"Shortlisted - {job?.Title}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Shortlisted Candidates for @job?.Title</h2>
    <div>
        @if (Model.Any())
        {
            <form method="post" asp-action="RejectAllNonShortlisted" asp-route-jobId="@job?.Id"
                  onsubmit="return confirm('WARNING: This will send rejection emails to ALL candidates who are not shortlisted. They will be removed from the list. Continue?')"
                  style="display: inline;">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-envelope-paper"></i> Reject All Others
                </button>
            </form>
        }
        <a asp-action="ViewApplications" asp-route-jobId="@job?.Id" class="btn btn-secondary ms-2">All Applications</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No shortlisted candidates yet.
        @if (ViewBag.HasRejected)
        {
            <p class="mt-2 mb-0">All non-shortlisted candidates have been rejected.</p>
        }
        else
        {
            <p class="mt-2 mb-0">Applications will be auto-shortlisted based on skill match (minimum 10% match required).</p>
        }
    </div>
}
else
{
    <div class="row">
        @foreach (var app in Model.Where(a => a.Status != "Rejected").ToList())
        {
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@app.CandidateName</h5>
                        <p class="text-muted">@app.Email | @app.Phone</p>
                        <div class="mb-2">
                            <span class="badge-active">Match Score: @app.MatchScore%</span>
                        </div>
                        <p><strong>Skills Match:</strong> @app.ExtractedSkills</p>
                        <p><small>Applied: @app.AppliedDate.ToShortDateString()</small></p>
                        <div class="mt-3">
                            @if (!string.IsNullOrEmpty(app.CVFilePath))
                            {
                                <a href="@app.CVFilePath" target="_blank" class="btn btn-sm btn-secondary me-2">
                                    <i class="bi bi-file-earmark-text"></i> View CV
                                </a>
                            }
                            @if (app.Status != "Hired")
                            {
                                <form method="post" asp-action="HireCandidate" style="display:inline">
                                    <input type="hidden" name="applicationId" value="@app.Id" />
                                    <button type="submit" class="btn btn-sm btn-success"
                                            onclick="return confirm('Hire @app.CandidateName? This will create an employee account and send credentials.')">
                                        <i class="bi bi-trophy"></i> Hire
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge" style="background-color: #2E7D32;">Hired</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (!Model.Any(a => a.Status != "Rejected"))
{
    <div class="alert alert-success mt-3">
        <i class="bi bi-check-circle"></i> All candidates have been processed. No pending shortlisted candidates.
    </div>
}