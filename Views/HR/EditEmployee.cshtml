@model EmployeeManagementSystem.Models.Employee
@{
    ViewData["Title"] = "Edit Employee";
}

<h2>Edit Employee</h2>

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label>Current Picture</label>
        @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
        {
            <div>
                <img src="@Model.ProfilePicturePath" style="max-width: 100px; max-height: 100px;" />
            </div>
        }
        <label>Change Picture</label>
        <input type="file" name="profileImage" class="form-control" accept="image/*" />
    </div>
    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Email (must end with @@gmail.com)</label>
        <input asp-for="Email" class="form-control" type="email" required />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Department</label>
        <input asp-for="Department" class="form-control" required />
        <span asp-validation-for="Department" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Phone (11 numeric digits, no spaces/dashes)</label>
        <input asp-for="Phone" class="form-control" required />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Salary</label>
        <input asp-for="Salary" class="form-control" type="number" step="0.01" required />
        <span asp-validation-for="Salary" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="ManageEmployees" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}