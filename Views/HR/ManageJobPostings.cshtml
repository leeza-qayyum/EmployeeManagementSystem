@model List<EmployeeManagementSystem.Models.JobPosting>
@{
    ViewData["Title"] = "Manage Jobs";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2>Job Postings</h2>
    <a asp-action="CreateJobPosting" class="btn btn-teal">
        <i class="bi bi-plus-circle"></i> Create New Job
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No job postings yet. Click "Create New Job" to get started.</div>
}
else
{
    <div class="row">
        @foreach (var job in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <!-- Header with title and status -->
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div>
                                <h5 class="card-title mb-1">@job.Title</h5>
                                <p class="text-muted mb-0 small">
                                    Department: @job.Department | Posted: @job.PostedDate.ToShortDateString()
                                </p>
                                @if (job.ApplicationDeadline.HasValue)
                                {
                                    <p class="text-muted mb-0 small">
                                        Deadline: @job.ApplicationDeadline.Value.ToShortDateString()
                                    </p>
                                }
                            </div>
                            <div>
                                @if (job.IsActive)
                                {
                                    if (job.ApplicationDeadline.HasValue && job.ApplicationDeadline.Value < DateTime.Now)
                                    {
                                        <span class="badge-terminated">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge-active">Active</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge-terminated">Closed</span>
                                }
                            </div>
                        </div>

                        <!-- Description -->
                        <p class="card-text mt-2">@(job.Description.Length > 120 ? job.Description.Substring(0, 120) + "..." : job.Description)</p>

                        <!-- Required Skills -->
                        <div class="mb-2">
                            <small class="text-muted">Required: @job.RequiredSkills</small>
                        </div>

                        <!-- Action Buttons - flex wrap prevents collision -->
                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a asp-action="ViewApplications" asp-route-jobId="@job.Id" class="btn btn-sm btn-teal">
                                <i class="bi bi-eye"></i> View Apps
                            </a>
                            <a asp-action="ShortlistedCandidates" asp-route-jobId="@job.Id" class="btn btn-sm btn-primary">
                                <i class="bi bi-star"></i> Shortlisted
                            </a>

                            @if (job.IsActive)
                            {
                                <button type="button" class="btn btn-sm btn-secondary copy-link" data-link="@job.GoogleFormLink">
                                    <i class="bi bi-link"></i> Copy Link
                                </button>
                                <form method="post" asp-action="CloseJobPosting" style="display:inline">
                                    <input type="hidden" name="id" value="@job.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Close this job posting?')">
                                        <i class="bi bi-x-circle"></i> Close
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.copy-link').forEach(btn => {
            btn.addEventListener('click', function() {
                navigator.clipboard.writeText(this.dataset.link);
                alert('Application link copied to clipboard!');
            });
        });
    </script>
}