@model List<EmployeeManagementSystem.Models.Attendance>
@using EmployeeManagementSystem.Models
@{
    ViewData["Title"] = "Monthly Attendance";

    // Get months and years for dropdown
    var months = new List<SelectListItem>();
    for (int i = 1; i <= 12; i++)
    {
        months.Add(new SelectListItem { Value = i.ToString(), Text = new DateTime(2000, i, 1).ToString("MMMM"), Selected = i == ViewBag.Month });
    }

    var years = new List<SelectListItem>();
    int currentYear = DateTime.Now.Year;
    for (int i = currentYear - 2; i <= currentYear + 1; i++)
    {
        years.Add(new SelectListItem { Value = i.ToString(), Text = i.ToString(), Selected = i == ViewBag.Year });
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Monthly Attendance</h2>
    <form method="get" class="d-flex gap-2">
        <select name="month" class="form-select" style="width: auto;">
            @foreach (var month in months)
            {
                <option value="@month.Value" selected="@month.Selected">@month.Text</option>
            }
        </select>
        <select name="year" class="form-select" style="width: auto;">
            @foreach (var year in years)
            {
                <option value="@year.Value" selected="@year.Selected">@year.Text</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">View</button>
    </form>
</div>


<!-- Statistics Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <i class="bi bi-calendar-month" style="font-size: 2rem; color: #2C3E8F;"></i>
                <h3 class="mt-2 mb-0">@ViewBag.TotalDays</h3>
                <p class="text-muted mb-0">Total Days</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <i class="bi bi-check-circle-fill" style="font-size: 2rem; color: #2E7D32;"></i>
                <h3 class="mt-2 mb-0">@ViewBag.AttendedDays</h3>
                <p class="text-muted mb-0">Days Attended</p>
                <small class="text-muted">(Present + Late)</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <i class="bi bi-exclamation-triangle-fill" style="font-size: 2rem; color: #F5A623;"></i>
                <h3 class="mt-2 mb-0">@ViewBag.LateDays</h3>
                <p class="text-muted mb-0">Late Arrivals</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <i class="bi bi-x-circle-fill" style="font-size: 2rem; color: #C0392B;"></i>
                <h3 class="mt-2 mb-0">@ViewBag.AbsentDays</h3>
                <p class="text-muted mb-0">Absent</p>
            </div>
        </div>
    </div>
</div>
<!-- Attendance Percentage Card -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <span>Attendance Rate</span>
                    <span class="fw-bold">@ViewBag.AttendancePercentage%</span>
                </div>
                <div class="progress mt-2" style="height: 10px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @ViewBag.AttendancePercentage%;" aria-valuenow="@ViewBag.AttendancePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Daily Attendance Table -->
<div class="card shadow-sm">
    <div class="card-body">
        <h5>Daily Attendance for @ViewBag.MonthName</h5>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Day</th>
                            <th>Check-In Time</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.OrderBy(r => r.Date))
                        {
                            <tr style="text-align: center;">
                                <td style="vertical-align: middle;">@record.Date.ToString("dd/MM/yyyy")</td>
                                <td style="vertical-align: middle;">@record.Date.ToString("dddd")</td>
                                <td style="vertical-align: middle;">@(record.CheckInTime?.ToString("hh:mm tt") ?? "-")</td>
                                <td style="vertical-align: middle;">
                                    @if (record.Status == AttendanceStatus.Late)
                                    {
                                        <span class="badge-warning">Late</span>
                                    }
                                    else if (record.Status == AttendanceStatus.Present)
                                    {
                                        <span class="badge-active">Present</span>
                                    }
                                    else if (record.Status == AttendanceStatus.HalfDay)
                                    {
                                        <span class="badge-secondary">Half Day</span>
                                    }
                                    else
                                    {
                                        <span class="badge-danger">Absent</span>
                                    }
                                </td>
                                <td style="vertical-align: middle;">@(string.IsNullOrEmpty(record.Remarks) ? "-" : record.Remarks)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No attendance records found for @ViewBag.MonthName.
            </div>
        }
    </div>
</div>

<div class="mt-3 text-center">
    <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>