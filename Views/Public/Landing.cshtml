@{
    ViewData["Title"] = "Job Opportunities";
    var jobs = ViewBag.Jobs as List<JobPosting> ?? new List<JobPosting>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Job Opportunities - EMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            background: linear-gradient(135deg, #2C3E8F 0%, #3A7B8C 100%);
            min-height: 100vh;
        }

        .job-card {
            border-radius: 15px;
            transition: transform 0.2s;
        }

            .job-card:hover {
                transform: translateY(-5px);
            }
    </style>
</head>
<body>
    <div class="container py-5">
        <div class="text-center mb-5">
            <h1 class="text-white">Career Opportunities</h1>
            <p class="text-white-50">Find your next career with us</p>
        </div>

        <div class="row">
            @if (jobs.Any())
            {
                @foreach (var job in jobs)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card job-card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title">@job.Title</h5>
                                <p class="text-muted">@job.Department</p>
                                <p class="card-text small">@(job.Description.Length > 100 ? job.Description.Substring(0, 100) + "..." : job.Description)</p>
                                <div class="mb-2">
                                    <span class="badge-active">Required: @job.RequiredSkills</span>
                                </div>
                                @if (job.ApplicationDeadline.HasValue)
                                {
                                    <p class="small text-muted mt-2">Deadline: @job.ApplicationDeadline.Value.ToShortDateString()</p>
                                }
                                <a href="/Public/Apply?jobId=@job.Id" class="btn btn-teal w-100 mt-2">Apply Now</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-info text-center">
                        <i class="bi bi-info-circle"></i> No active job postings at the moment. Please check back later.
                    </div>
                </div>
            }
        </div>
    </div>
</body>
</html>