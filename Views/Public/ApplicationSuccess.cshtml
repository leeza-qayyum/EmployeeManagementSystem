@{
    ViewData["Title"] = "Application Submitted";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-success">
                <div class="card-body p-5">
                    <i class="bi bi-check-circle-fill" style="font-size: 64px; color: #28a745;"></i>
                    <h2 class="mt-3 text-success">Application Submitted!</h2>
                    <p class="lead mt-3">@ViewBag.Message</p>
                    <p>Your CV has been received and will be reviewed by our HR team.</p>
                    <hr />
                    <p class="text-muted">You will be contacted if your profile matches our requirements.</p>
                    
                </div>
            </div>
        </div>
    </div>
</div>