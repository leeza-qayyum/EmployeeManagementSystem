@{
    ViewData["Title"] = "Applications Closed";
    var error = ViewBag.Error as string ?? "This job posting is no longer accepting applications.";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Applications Closed - EMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            background: linear-gradient(135deg, #2C3E8F 0%, #3A7B8C 100%);
            min-height: 100vh;
        }

        .closed-card {
            border-radius: 20px;
            box-shadow: 0 20px 35px rgba(0,0,0,0.2);
            animation: fadeIn 0.5s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .closed-icon {
            font-size: 80px;
            color: #dc3545;
            background: white;
            border-radius: 50%;
            padding: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-6 col-lg-5">
                <div class="card closed-card text-center p-4">
                    <div class="card-body">
                        <div class="mb-4">
                            <div class="closed-icon d-inline-flex align-items-center justify-content-center">
                                <i class="bi bi-calendar-x-fill"></i>
                            </div>
                        </div>

                        <h2 class="text-danger mb-3">Applications Closed</h2>

                        <p class="lead">@error</p>

                        <div class="alert alert-warning mt-4">
                            <i class="bi bi-info-circle"></i>
                            <small>Please check our <a href="/Public/Landing" class="alert-link">active job listings</a> for other opportunities.</small>
                        </div>

                        <hr />

                        <div class="mt-4">
                            <a href="/Public/Landing" class="btn btn-primary">
                                <i class="bi bi-briefcase"></i> View Active Jobs
                            </a>
                           
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>