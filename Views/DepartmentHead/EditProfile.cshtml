@model EmployeeManagementSystem.Models.Employee
@{
    ViewData["Title"] = "Edit Profile";
}
<h2>Edit Your Profile</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label>Email (must end with @@gmail.com)</label>
        <input asp-for="Email" class="form-control" type="email" required />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Department</label>
        <input asp-for="Department" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label>Phone (11 digits)</label>
        <input asp-for="Phone" class="form-control" required />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Salary</label>
        <input asp-for="Salary" class="form-control" readonly/>
    </div>

    <div class="mb-3">
        <label>Profile Picture</label>
        @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
        {
            <div class="mb-2">
                <img src="@Model.ProfilePicturePath" style="width: 100px; height: 100px; border-radius: 50%;" />
            </div>
        }
        <input type="file" name="profileImage" class="form-control" accept="image/*" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="ViewProfile" class="btn btn-secondary">Cancel</a>
</form>